<%- include('../partials/head') %><%- include('../partials/shell') %><div id="practice-room" data-session="<%= practice._id %>" data-user="<%= user._id %>" data-partner="<%= partner._id %>" data-status="<%= practice.status %>" data-ends="<%= practice.endsAt?date(practice.endsAt):'' %>" data-scheduled="<%= date(practice.scheduledFor) %>" data-extended="<%= practice.extensionUsed %>"><div class="page-heading"><div><span class="eyebrow">A LITTLE PRACTICE GOES A LONG WAY</span><h1>Let’s talk, <%= user.name.split(' ')[0] %>.</h1><p><%= practice.language %> practice with <%= partner.name %></p></div><div class="timer"><%- include('../partials/icon',{name:'clock'}) %><strong id="timer">15:00</strong><span id="timer-label">practice time</span></div></div><div class="room-grid"><section class="video-panel"><div class="video-stage"><span id="call-status" class="badge call-badge" role="status">Waiting for your partner</span><video id="remote-video" autoplay playsinline hidden></video><button id="play-remote" class="btn light small" hidden>Play partner audio / video</button><span id="partner-status" class="badge partner-status">Partner offline</span><div id="remote-placeholder" class="remote-placeholder"><%- include('../partials/avatar',{person:partner,large:true}) %><h2><%= partner.name %></h2><p><span id="remote-hint">Your partner’s camera is off.<br>Turn on your camera or microphone below to share.</span></p></div><div class="self-preview"><video id="local-video" muted playsinline autoplay hidden></video><div id="local-placeholder"><%- include('../partials/avatar',{person:user}) %><span>You · camera off</span></div></div><div class="video-controls"><button id="camera-toggle" class="round-button" aria-label="Turn on camera" aria-pressed="false"><%- include('../partials/icon',{name:'video'}) %></button><button id="mic-toggle" class="round-button" aria-label="Turn on microphone" aria-pressed="false"><%- include('../partials/icon',{name:'mic'}) %></button><button id="leave-room" class="round-button red" aria-label="Leave session"><%- include('../partials/icon',{name:'exit'}) %></button></div></div><div class="video-info"><div class="row between"><div><span class="eyebrow">A MOMENT TO CONNECT</span><h3>Start with something simple.</h3></div><span class="tag"><%= practice.language %></span></div><p id="conversation-prompt">What’s a small thing that made you smile this week?</p><button id="next-prompt" class="text-link">Try another conversation starter ↻</button><div class="call-help"><p id="call-detail" aria-live="polite">Camera and microphone start off. Enable each one when you’re ready.</p><button id="retry-call" class="text-link" type="button">Reconnect call ↻</button></div><div class="session-tools"><% if(same(user,helper)){ %><button id="extend-session" class="btn outline small" <%= practice.extensionUsed?'disabled':'' %>>Add 5 minutes <span>once per session</span></button><% } %><button id="end-session" class="btn dark small">End practice</button></div><p class="caption">Your enabled camera and microphone are shared live with your partner. Nothing is recorded. Use headphones when testing nearby devices. A completed session counts after both enter and at least one minute passes.</p></div></section><section class="chat-panel"><div class="chat-header"><div><h2>Room chat</h2><p><span class="dot"></span> <span id="connection-status">Connecting…</span></p></div><span class="tag">Just you two</span></div><div id="messages" class="messages" role="log" aria-label="Practice messages" aria-live="polite"><p class="chat-welcome">A safe space to try, pause, and try again.<br>Say hello to <%= partner.name.split(' ')[0] %>.</p></div><div id="typing" class="typing" aria-live="polite"></div><form id="chat-form" class="chat-form"><label class="sr-only" for="chat-input">Your message</label><input id="chat-input" maxlength="2000" placeholder="Start with a hello…" autocomplete="off" disabled><button class="btn dark" aria-label="Send message" id="send-message" disabled><%- include('../partials/icon',{name:'send'}) %></button></form><details class="room-safety"><summary>Privacy & safety</summary><button class="text-button danger" data-block="<%= partner._id %>">Block partner & end session</button><form data-report="<%= partner._id %>" class="stack"><input type="hidden" name="sessionId" value="<%= practice._id %>"><label>Reason<select name="reason"><option>Harassment</option><option>Inappropriate content</option><option>Spam</option><option>Other</option></select></label><label>Details<textarea name="description" required maxlength="1000"></textarea></label><button class="btn outline small">Submit report</button><small>Saved for project review. No live moderation team.</small></form></details></section></div></div><script src="/socket.io/socket.io.js" defer></script><script src="/js/peer-call.js" defer></script><script src="/js/call-ui.js" defer></script><script src="/js/room.js" defer></script><%- include('../partials/end',{shell:true}) %>
