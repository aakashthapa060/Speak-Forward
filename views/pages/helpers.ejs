<%- include('../partials/head') %><% if(user){ %><%- include('../partials/shell') %><div class="discovery discovery-in-app"><% }else{ %><%- include('../partials/nav') %><main class="wrap discovery"><% } %><div class="discovery-title"><span class="eyebrow">YOUR PEOPLE ARE OUT THERE</span><h1>A new language.<br><em>A familiar feeling.</em></h1><p>Meet friendly people who’ll help you turn “I wish I could” into “let’s talk.”</p></div><form class="filters" action="/helpers"><label class="search-field"><span class="sr-only">Search by name</span><%- include('../partials/icon',{name:'search'}) %><input type="search" name="q" value="<%= query.q||'' %>" placeholder="Find a friendly face…" maxlength="80"></label><label><span class="sr-only">Language</span><select name="language"><option value="">All languages</option><% for(const l of languages){ %><option <%= query.language===l?'selected':'' %>><%= l %></option><% } %></select></label><label><span class="sr-only">Practice level</span><select name="level"><option value="">Any level</option><% for(const l of levels){ %><option <%= query.level===l?'selected':'' %>><%= l %></option><% } %></select></label><label><span class="sr-only">Availability</span><select name="available"><option value="">Any availability</option><option value="now" <%= query.available==='now'?'selected':'' %>>Available now</option></select></label><button class="btn dark small">Find helpers</button></form><div class="row between results-line"><span><strong><%= helpers.length %></strong> <%= helpers.length===1?'helper':'helpers' %> to meet</span><a class="text-link" href="/match"><%- include('../partials/icon',{name:'spark'}) %> Find my match</a></div><div class="helper-grid"><% for(const h of helpers){ %><%- include('../partials/helper-card',{person:h.user,offers:h.offers}) %><% } %><% if(!helpers.length){ %><div class="empty"><h2>No matches just yet.</h2><p>Try another language, a different level, or upcoming availability.</p><a class="btn outline" href="/helpers">Clear filters</a></div><% } %></div><div class="discovery-bottom"><span class="sun-symbol">✳</span><div><h3>You have something to share, too.</h3><p>Your everyday language could open someone else’s world.</p></div><a class="btn outline" href="<%= user?'/availability':'/register' %>">Become a helper ↗</a></div><% if(user){ %></div><% }else{ %></main><% } %><%- include('../partials/end',{shell:!!user}) %>
