<%- include('../partials/head') %><%- include('../partials/nav') %><main class="auth-layout wrap"><section class="auth-art"><span class="eyebrow">SPEAK FORWARD / YOUR NEXT CHAPTER</span><h1>A shared language.<br>A new <em>connection.</em></h1><div class="auth-hello">hello<span>olá</span></div><p>There’s someone out there who can help you find your voice. And someone who could use yours.</p></section><section class="auth-form"><span class="eyebrow"><%= mode==='login'?'GOOD TO SEE YOU AGAIN':'LET’S START WITH YOU' %></span><h2><%= mode==='login'?'Welcome back.':'Make yourself at home.' %></h2><p class="muted"><%= mode==='login'?'Your next conversation is waiting.':'A few details, a world of possibilities.' %></p><form action="/<%= mode %>" method="post" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(mode==='register'){ %><label>Full name<input name="name" required maxlength="80" autocomplete="name" placeholder="Aakash Thapa"></label><label>Username<input name="username" required pattern="[a-z0-9_]{3,24}" maxlength="24" autocomplete="username" placeholder="aakash_thapa"><small>3–24 lowercase letters, numbers or underscores</small></label><% } %><label>Email address<input name="email" type="email" required maxlength="200" autocomplete="email" placeholder="you@example.com"></label><label>Password<input name="password" type="password" required minlength="<%= mode==='register'?10:1 %>" maxlength="72" autocomplete="<%= mode==='login'?'current-password':'new-password' %>" placeholder="<%= mode==='register'?'At least 10 characters':'Your password' %>"></label><% if(mode==='register'){ %><label>Confirm password<input name="confirmPassword" type="password" required autocomplete="new-password"></label><label class="check"><input type="checkbox" name="adult" required> I confirm that I am 18 years or older.</label><% } %><button class="btn dark" type="submit"><%= mode==='login'?'Log in':'Create my account' %> <%- include('../partials/icon',{name:'arrow'}) %></button></form><p class="auth-switch"><%= mode==='login'?'New around here?':'Already part of the community?' %> <a href="<%= mode==='login'?'/register':'/login' %>"><%= mode==='login'?'Join us':'Log in' %></a></p></section></main><%- include('../partials/end') %>
