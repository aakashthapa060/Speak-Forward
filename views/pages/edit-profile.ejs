<%- include('../partials/head') %><%- include('../partials/shell') %><div class="page-heading"><div><span class="eyebrow">YOUR STORY, IN YOUR WORDS</span><h1>A little more you.</h1><p>Give your next conversation a place to start.</p></div></div><form class="panel edit-form stack" action="/profile/edit" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="row"><%- include('../partials/avatar',{person:user,large:true}) %><div><label>Profile picture<input type="file" name="avatar" accept="image/png,image/jpeg,image/webp"></label><small>JPG, PNG or WebP · Up to 3 MB · Cropped to a square</small><label class="check"><input type="checkbox" name="removeImage"> Remove current picture</label></div></div><div class="form-grid"><label>Full name<input name="name" value="<%= user.name %>" required maxlength="80"></label><label>Country<input name="country" value="<%= user.country %>" maxlength="80" placeholder="Canada"></label><label>Time zone<input name="timeZone" value="<%= user.timeZone %>" required placeholder="America/Toronto"><small>Use an IANA time zone, e.g. America/Toronto</small></label><label>Username<input value="<%= user.username %>" disabled><small>Your username stays the same.</small></label></div><label>A little about you<textarea name="bio" maxlength="600" rows="4" placeholder="What do you love talking about?"><%= user.bio %></textarea></label><label>Your learning goals<textarea name="goals" maxlength="300" rows="2" placeholder="I’d like to feel confident having everyday conversations…"><%= user.goals %></textarea></label><div class="form-grid"><% for(const kind of ['spoken','learning']){const list=kind==='spoken'?user.languagesSpoken:user.languagesLearning; %><fieldset><legend><%= kind==='spoken'?'Languages I speak':'Languages I’m learning' %></legend><% for(let i=0;i<3;i++){const val=list[i]; %><div class="row language-row"><label><span class="sr-only">Language <%= i+1 %></span><select name="<%= kind %>Language<%= i||'' %>"><option value="">Add a language</option><% for(const l of languages){ %><option <%= val?.language===l?'selected':'' %>><%= l %></option><% } %></select></label><label><span class="sr-only">Level <%= i+1 %></span><select name="<%= kind %>Level<%= i||'' %>"><% for(const l of levels){ %><option <%= val?.level===l?'selected':'' %>><%= l %></option><% } %></select></label></div><% } %></fieldset><% } %></div><label class="check helper-toggle"><input type="checkbox" name="helperEnabled" <%= user.helperEnabled?'checked':'' %>><span><strong>I’d like to help others practice</strong><small>You can be a learner and a helper. Create offers on My Availability after saving.</small></span></label><div class="row"><button class="btn dark">Save my profile <%- include('../partials/icon',{name:'arrow'}) %></button><a class="btn outline" href="/profile/<%= user._id %>">Cancel</a></div></form><% if(blocks.length){ %><section class="panel edit-form"><h2>Blocked people</h2><% for(const b of blocks){ %><div class="row between"><span><%= b.blockedUserId.name %></span><button class="text-button" data-unblock="<%= b.blockedUserId._id %>">Unblock</button></div><% } %></section><% } %><%- include('../partials/end',{shell:true}) %>
