<%- include('../partials/head') %><% if(user){ %><%- include('../partials/shell') %><% }else{ %><%- include('../partials/nav') %><main class="wrap section"><% } %><div class="breadcrumb"><a href="/helpers">Helpers</a><span>/</span><%= profile.name %></div><div class="profile-layout"><section class="panel profile-summary"><div class="profile-cover"><span>EVERY CONVERSATION IS A NEW BEGINNING</span><span class="cover-sun">✳</span></div><div class="profile-intro"><%- include('../partials/avatar',{person:profile,large:true}) %><% if(same(user,profile)){ %><a class="text-link" href="/profile/edit">Edit profile ↗</a><% } %><h1><%= profile.name %></h1><p class="muted">@<%= profile.username %> <%= profile.helperEnabled?'· Community helper':'· Language learner' %></p><div class="profile-facts"><div><span>Based in</span><strong><%= profile.country||'Not added yet' %></strong></div><div><span>Time zone</span><strong><%= profile.timeZone %></strong></div></div><h3>A little about me</h3><p class="bio"><%= profile.bio||'Every good story starts with a hello. This member is still writing theirs.' %></p><h3>I speak</h3><div class="chips"><% for(const l of profile.languagesSpoken){ %><span class="tag"><%= l.language %> · <%= l.level %></span><% } %></div><h3>I’m learning</h3><div class="chips"><% for(const l of profile.languagesLearning){ %><span class="tag"><%= l.language %> · <%= l.level %></span><% } %></div><% if(profile.goals){ %><h3>What I’m working toward</h3><p class="bio"><%= profile.goals %></p><% } %></div></section><div class="stack"><div class="profile-stats"><div class="panel"><strong><%= profile.helpGiven %></strong><span>Help Given</span></div><div class="panel"><strong><%= profile.helpReceived %></strong><span>Help Received</span></div></div><section class="panel offers-panel"><span class="eyebrow">MAKE TIME FOR A HELLO</span><h2>Let’s practice together.</h2><p class="muted">15 minutes. A friendly conversation. No pressure to be perfect.</p><% if(unavailable){ %><p class="empty compact">This connection is unavailable.</p><% }else if(!profile.helperEnabled||!offers.length){ %><p class="empty compact">No open practice offers right now. Check back soon.</p><% }else{ %><% for(const o of offers){ %><article class="offer"><div class="row between"><strong><%= o.language %> conversation</strong><span class="tag"><%= o.level %></span></div><p>From <time datetime="<%= date(o.startTime) %>"></time><br>Until <time datetime="<%= date(o.endTime) %>"></time></p><% if(!same(user,profile)){ %><% if(user){ %><form data-offer-request class="stack"><input type="hidden" name="offerId" value="<%= o._id %>"><label>Pick a time <small>(optional; defaults to earliest available)</small><input type="datetime-local" name="proposedTime" data-local-min="<%= date(new Date(Math.max(Date.now(),o.startTime.getTime()))) %>" data-local-max="<%= date(new Date(o.endTime.getTime()-900000)) %>"></label><button class="btn dark small">Request practice <%- include('../partials/icon',{name:'arrow'}) %></button></form><% }else{ %><a class="btn dark small" href="/login">Log in to request practice</a><% } %><% } %></article><% } %><% } %><% if(same(user,profile)){ %><a href="/availability" class="btn outline">Manage my availability →</a><% } %></section><div class="soft-note"><%- include('../partials/icon',{name:'chat'}) %><p>Both people confirm before a room opens. Chat, audio and video stay in your private practice room. Your camera and microphone start off.</p></div><% if(user&&!same(user,profile)){ %><details class="panel safety-details"><summary>Privacy & safety</summary><p>You control who you practice with.</p><button class="text-button danger" data-block="<%= profile._id %>">Block this person</button><form data-report="<%= profile._id %>" class="stack"><label>Report reason<select name="reason"><option>Harassment</option><option>Inappropriate content</option><option>Spam</option><option>Other</option></select></label><label>What happened?<textarea name="description" required maxlength="1000"></textarea></label><button class="btn outline small">Submit report</button><small>Saved for project review. No live moderation team.</small></form></details><% } %></div></div><% if(!user){ %></main><% } %><%- include('../partials/end',{shell:!!user}) %>
