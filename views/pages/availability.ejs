<%- include('../partials/head') %><%- include('../partials/shell') %><div class="page-heading"><div><span class="eyebrow">GIVE A LITTLE. GO FURTHER.</span><h1>Make room for a conversation.</h1><p>Share a language you know, at a time that works for you.</p></div></div><% if(!user.helperEnabled){ %><div class="panel soft-note"><p>First, turn on “I’d like to help others practice” in your profile.</p><a class="btn dark small" href="/profile/edit">Enable helping →</a></div><% } %><div class="dashboard-columns"><section class="panel"><h2>Your practice offers</h2><p class="muted">One reservation per offer. A free offer is reusable until its availability ends.</p><% if(!offers.length){ %><div class="empty compact"><h3>Your first hello starts here.</h3><p>Add an availability window to appear in helper discovery.</p></div><% } %><% for(const o of offers){ %><article class="offer"><div class="row between"><h3><%= o.language %> · <%= o.level %></h3><span class="tag"><%= o.reservedBy?'Reserved':o.endTime<new Date()?'Expired':'Open' %></span></div><p><time datetime="<%= date(o.startTime) %>"></time> — <time datetime="<%= date(o.endTime) %>"></time></p><% if(!o.reservedBy){ %><div class="row"><button class="text-button" data-edit-offer="<%= o._id %>" data-language="<%= o.language %>" data-level="<%= o.level %>" data-start="<%= date(o.startTime) %>" data-end="<%= date(o.endTime) %>">Edit offer</button><button class="text-button danger" data-delete-offer="<%= o._id %>">Remove</button></div><% }else{ %><a class="text-link" href="/dashboard#requests">Manage reservation →</a><% } %></article><% } %></section><section class="panel"><h2 id="offer-form-title">Add an offer</h2><form id="offer-form" class="stack"><input type="hidden" name="id"><label>Language<select name="language"><% for(const l of languages){ %><option><%= l %></option><% } %></select></label><label>Level you can support<select name="level"><% for(const l of levels){ %><option><%= l %></option><% } %></select></label><label>Available from<input type="datetime-local" name="startTime" required></label><label>Available until<input type="datetime-local" name="endTime" required></label><small>Times use your browser’s local time zone. Keep a window of 15 minutes to 7 days.</small><button class="btn dark" <%= !user.helperEnabled?'disabled':'' %>>Save availability ↗</button><button class="text-button" type="reset">Clear form</button></form></section></div><%- include('../partials/end',{shell:true}) %>
