<%- include('../partials/head') %><%- include('../partials/shell') %><div class="page-heading"><div><span class="eyebrow">A LITTLE PRACTICE, A LITTLE PROGRESS</span><h1>Hello, <%= user.name.split(' ')[0] %><span class="purple">.</span></h1><p>Here’s what’s happening in your corner of the world.</p></div><a class="btn dark" href="/helpers">Find a helper <%- include('../partials/icon',{name:'arrow'}) %></a></div>
<% const active=sessions.filter(s=>['active','scheduled'].includes(s.status)), history=sessions.filter(s=>['completed','cancelled'].includes(s.status)); %>
<div class="stat-grid"><a class="stat" href="#history"><span class="stat-icon"><%- include('../partials/icon',{name:'people'}) %></span><strong><%= user.helpGiven %><small>conversations</small></strong><span>Help Given</span></a><a class="stat" href="#history"><span class="stat-icon purple-bg"><%- include('../partials/icon',{name:'chat'}) %></span><strong><%= user.helpReceived %><small>conversations</small></strong><span>Help Received</span></a><a class="stat" href="#upcoming"><span class="stat-icon pale"><%- include('../partials/icon',{name:'calendar'}) %></span><strong><%= active.length %><small>sessions</small></strong><span>Coming up</span></a><a class="stat" href="#requests"><span class="stat-icon pale"><%- include('../partials/icon',{name:'clock'}) %></span><strong><%= requests.length %><small>requests</small></strong><span>To connect</span></a></div>
<div class="dashboard-columns"><div class="stack"><section class="panel" id="upcoming"><div class="section-heading"><h2>Your next conversations</h2><span class="tag">15 minutes to connect</span></div><% if(!active.length){ %><div class="empty compact"><span class="empty-icon"><%- include('../partials/icon',{name:'chat'}) %></span><h3>Something good starts with hello.</h3><p>Find a helper and make room for your first conversation.</p><a class="text-link" href="/helpers">Meet your people →</a></div><% } %><% for(const s of active){ const partner=same(s.helperId,user)?s.learnerId:s.helperId; %><article class="session-row"><%- include('../partials/avatar',{person:partner}) %><div class="grow"><strong><%= s.language %> with <%= partner.name %></strong><p><time datetime="<%= date(s.scheduledFor) %>"></time> · <%= s.status %></p></div><a class="btn <%= s.status==='active'?'purple-button':'outline' %> small" href="/sessions/<%= s._id %>">Open room ↗</a><button class="icon-button" data-end="<%= s._id %>" data-cancel="true" aria-label="Cancel session">×</button></article><% } %></section>
<section class="panel" id="requests"><div class="section-heading"><h2>Let’s make it happen</h2><span class="muted small-text">Practice requests</span></div><% if(!requests.length){ %><p class="empty compact">No pending requests. Your next connection is out there.</p><% } %><% for(const r of requests){const isHelper=same(r.helperId,user);const partner=isHelper?r.learnerId:r.helperId;const confirmed=isHelper?r.helperConfirmed:r.learnerConfirmed; %><article class="request-row"><div class="row"><%- include('../partials/avatar',{person:partner}) %><div class="grow"><strong><%= partner.name %></strong><p><%= r.language %> · <time datetime="<%= date(r.proposedTime) %>"></time></p></div><span class="tag"><%= r.status %></span></div><div class="request-actions"><% if(r.status==='pending'&&isHelper){ %><button class="btn dark small" data-request="<%= r._id %>" data-action="accept">Accept</button><button class="btn outline small" data-request="<%= r._id %>" data-action="decline">Decline</button><% }else if(r.status==='pending'){ %><span class="muted small-text">Waiting for your helper to accept</span><% }else if(!confirmed){ %><button class="btn purple-button small" data-request="<%= r._id %>" data-action="confirm">Confirm I’ll be there</button><% }else{ %><span class="muted small-text"><%= r.helperConfirmed&&r.learnerConfirmed?'Both confirmed. Your room is ready above.':'You’re confirmed. Waiting for your partner.' %></span><% } %><button class="text-button" data-request="<%= r._id %>" data-action="cancel">Cancel request</button></div></article><% } %></section>
<section class="panel" id="history"><div class="section-heading"><h2>Conversations worth keeping</h2><span class="muted small-text">Session history</span></div><% if(!history.length){ %><p class="empty compact">Your completed sessions will find a home here.</p><% } %><% for(const s of history){const partner=same(s.helperId,user)?s.learnerId:s.helperId; %><div class="history-row"><span class="history-dot"></span><div class="grow"><strong><%= s.language %> with <%= partner.name %></strong><p><time datetime="<%= date(s.completedAt||s.updatedAt) %>"></time></p></div><span class="tag"><%= s.status %><%= s.qualified?' · counted':'' %></span></div><% } %><p class="caption">Tallies count completed sessions where both people enter and practice for at least one minute. Cancelled sessions don’t count.</p></section></div>
<aside class="stack"><section class="panel profile-progress"><div class="progress-ring"><strong><%= profileCompletion(user) %><small>%</small></strong><span>Your profile</span></div><h3>A little more you.</h3><p>Help people find their common ground with you.</p><a class="btn outline small" href="/profile/edit">Complete my profile ↗</a></section><section class="match-card"><span class="tag">MAKE A CONNECTION</span><%- include('../partials/icon',{name:'spark'}) %><h2>Less searching.<br>More speaking.</h2><p>A language. A level. A friendly face to practice with.</p><a class="btn light" href="/match">Match me <%- include('../partials/icon',{name:'arrow'}) %></a></section><section class="panel"><h3>On your learning list</h3><% if(!user.languagesLearning.length){ %><p class="muted">Where would you like to go next?</p><% } %><% for(const l of user.languagesLearning){ %><p><strong><%= l.language %></strong><br><span class="muted"><%= l.level %></span></p><% } %><a class="text-link" href="/profile/edit">Edit languages →</a></section></aside></div><%- include('../partials/end',{shell:true}) %>
