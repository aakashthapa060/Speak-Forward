<div class="app-shell"><aside class="sidebar"><a href="/" class="brand"><span class="brand-mark">s<span>f</span></span><span class="brand-text">Speak Forward.</span></a><p class="nav-label">YOUR SPACE</p><nav aria-label="Account navigation">
<% for(const item of [{href:'/dashboard',icon:'grid',text:'Overview'},{href:'/helpers',icon:'people',text:'Find helpers'},{href:'/match',icon:'spark',text:'Match me'},{href:'/availability',icon:'calendar',text:'My availability'},{href:'/profile/'+user._id,icon:'user',text:'My profile'}]){ %><a href="<%= item.href %>" class="<%= path===item.href?'selected':'' %>"><%- include('icon',{name:item.icon}) %><span><%= item.text %></span></a><% } %></nav><div class="sidebar-bottom"><div class="give-note"><%- include('icon',{name:'chat'}) %><strong>A little conversation.<br>A lasting difference.</strong><p>Pass your language forward.</p></div><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="logout"><%- include('icon',{name:'exit'}) %><span>Log out</span></button></form></div></aside><div class="workspace"><header class="workspace-top"><a class="search-link" href="/helpers"><%- include('icon',{name:'search'}) %><span>Find your next conversation</span></a><div class="row"><span class="desktop-only muted">A small hello goes a long way</span><a href="/profile/<%= user._id %>" aria-label="Your profile"><%- include('avatar',{person:user}) %></a></div></header><main class="workspace-body">
