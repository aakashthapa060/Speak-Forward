<article class="helper-card"><a class="helper-visual tone-<%= person.name.charCodeAt(0)%5 %>" href="/profile/<%= person._id %>"><span class="badge available"><span class="dot"></span><%= offers.some(o=>o.startTime<=new Date())?'Available now':'Upcoming availability' %></span><% if(person.profileImage){ %><img src="<%= person.profileImage %>" alt="<%= person.name %>" loading="lazy"><% }else{ %><div class="portrait-placeholder" aria-label="<%= person.name %> profile placeholder"><span><%= initials(person.name) %></span><div class="portrait-orbit"></div></div><% } %><div class="helper-caption"><span><%= offers[0]?.language||'Conversation' %> helper</span><h3><%= person.name %></h3><span><%= person.country||'Our global community' %></span></div><span class="card-arrow">↗</span></a><div class="helper-info"><div class="row between"><span class="tag"><%= offers[0]?.level %> practice</span><span class="muted small-text"><%= person.helpGiven %> helped</span></div><p><%= person.bio.slice(0,95) %><%= person.bio.length>95?'…':'' %></p><a class="text-link" href="/profile/<%= person._id %>">Meet <%= person.name.split(' ')[0] %> <%- include('icon',{name:'arrow'}) %></a></div></article>
