<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="<%= csrf %>"><title><%= title %> · Speak Forward</title><link rel="icon" href="/assets/images/mark.svg" type="image/svg+xml"><link rel="stylesheet" href="/css/style.css"><script src="/js/app.js" defer></script></head><body>
