NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/speak_forward?replicaSet=rs0&directConnection=true
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BASE_URL=http://localhost:3000
# Set your own local demo password before running npm run seed.
DEMO_PASSWORD=

# WebRTC. A public STUN server is used by default; blank disables STUN for local-only tests.
STUN_URL=stun:stun.l.google.com:19302
# For calls across restrictive networks, configure your TURN service (optional for local tests).
# Comma-separated turn:/turns: URLs from your provider. No TURN relay is bundled.
TURN_URLS=
# Coturn REST-style shared secret: server generates expiring browser credentials.
TURN_SHARED_SECRET=
# Alternatively, provider-issued client username/credential (visible to authorized participants).
TURN_USERNAME=
TURN_CREDENTIAL=
